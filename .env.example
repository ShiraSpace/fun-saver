# Copy to .env.local and fill in values — never commit .env.local.

# Neon Postgres — main branch (production). Used by Vercel deployments and by
# `npm run db:migrate`. When neither DATABASE_URL nor DEV_DATABASE_URL is set,
# the app falls back to the local JSON file store.
DATABASE_URL=

# Neon Postgres — dev branch. Used by `npm run dev` (via NODE_ENV=development)
# and by `npm run db:migrate-dev`. Keeps local experiments out of production.
DEV_DATABASE_URL=

# Neon Postgres — dedicated test branch. Used by `npm run db:migrate-test` and by any
# future integration tests that opt in (currently deferred; see
# .plans/2026-07-25-neon-integration.md).
TEST_DATABASE_URL=
